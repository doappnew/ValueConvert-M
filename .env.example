# Copiez vers .env pour le développement local. Ne mettez JAMAIS de vraies clés dans ce fichier d'exemple.
PORT=3000
NODE_ENV=development
APP_ENV=mainnet
# La valeur du Pi n'est pas encore disponible : 0 = affiche « à venir » (défaut). 1 = conversions de marché.
PI_VALUE_AVAILABLE=0
PI_SANDBOX=0
# Clé facultative CoinGecko (plan Demo). Vide = appels publics. À définir uniquement dans l'hébergeur.
COINGECKO_API_KEY=
# Contenu exact du fichier fourni par le Developer Portal (app Mainnet) pour vérifier le domaine (/validation-key.txt)
PI_VALIDATION_KEY=
# Clé API de CETTE application (Developer Portal) : uniquement dans Render, jamais ici.
PI_API_KEY=
# Pass payant (fermé par défaut). Ne l'activer que lorsque le service livre réellement ce que le pass donne.
PASS_ENABLED=0
PASS_PRICE_PI=0.5
PASS_DAYS=30
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
